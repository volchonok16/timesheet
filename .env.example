# Скопируйте в .env на сервере перед docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d

TFS_BASE_URL=https://tfs.t2.ru/tfs/Main
TFS_PROJECT=Tele2
TFS_PROJECT_ID=c56fb5fe-9752-462a-82ae-0b9e10364510
TFS_COST_PROJECT_DEFAULT=B2B 2026

TIMESHEET_DOMAIN=mateplace.ru
TIMESHEET_API_DOMAIN=api.mateplace.ru

APP_PUBLIC_URL=https://mateplace.ru
API_PUBLIC_URL=https://api.mateplace.ru
CORS_ALLOW_ORIGINS=https://mateplace.ru,https://www.mateplace.ru
VITE_API_URL=https://api.mateplace.ru

# Смените пароль БД в production
# POSTGRES_PASSWORD=...
# DATABASE_URL=postgresql+psycopg://timesheet:STRONG_PASSWORD@postgres:5432/timesheet

# Локально (docker-compose.dev.yml) раскомментируйте:
# APP_PUBLIC_URL=http://localhost:8080
# API_PUBLIC_URL=http://localhost:8080
# VITE_API_URL=
